<?xml version="1.0" encoding="utf-8"?>
<!--
  Nocturne.xaml — RDP Manager design system (dark).
  Drop into src/RdpManager.Presentation/Themes/ and merge in App.xaml:

    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
          <ResourceDictionary Source="ms-appx:///Themes/Nocturne.xaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Application.Resources>

  Every hex here is a Nocturne token — do not hand-pick colors elsewhere.
  Font: Inter (bundle the .ttf under Assets/Fonts and adjust FontFamily below,
  or install system-wide). Headings use weight 500; never heavier.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ══════════════════════════ COLORS ══════════════════════════ -->
  <!-- Ground / surface -->
  <Color x:Key="BgColor">#161826</Color>
  <Color x:Key="SurfaceColor">#232532</Color>
  <Color x:Key="PanelColor">#191B27</Color>
  <Color x:Key="PanelAltColor">#1A1C28</Color>
  <Color x:Key="CaptionTopColor">#20222F</Color>
  <Color x:Key="CaptionBottomColor">#1B1D29</Color>

  <!-- Text -->
  <Color x:Key="TextColor">#E9E9ED</Color>

  <!-- Accent (single blurple) + ramp -->
  <Color x:Key="AccentColor">#9184D9</Color>
  <Color x:Key="Accent200Color">#E7E5FE</Color>
  <Color x:Key="Accent300Color">#D2CEFD</Color>
  <Color x:Key="Accent400Color">#B5ABFC</Color>
  <Color x:Key="Accent500Color">#968AE0</Color>
  <Color x:Key="Accent600Color">#796CBF</Color>
  <Color x:Key="Accent700Color">#5D5294</Color>
  <Color x:Key="Accent800Color">#423A6A</Color>
  <Color x:Key="Accent900Color">#2B2741</Color>

  <!-- Neutral ramp -->
  <Color x:Key="Neutral100Color">#F3F5FE</Color>
  <Color x:Key="Neutral300Color">#CFD3E5</Color>
  <Color x:Key="Neutral400Color">#B2B6CA</Color>
  <Color x:Key="Neutral500Color">#9397AB</Color>
  <Color x:Key="Neutral600Color">#75798C</Color>
  <Color x:Key="Neutral700Color">#595D6C</Color>
  <Color x:Key="Neutral800Color">#3F424D</Color>
  <Color x:Key="Neutral900Color">#292B31</Color>

  <!-- Semantic -->
  <Color x:Key="SuccessColor">#5BC8A3</Color>
  <Color x:Key="WarningColor">#E0B24C</Color>
  <Color x:Key="ErrorColor">#E08C8C</Color>

  <!-- ══════════════════════════ BRUSHES ══════════════════════════ -->
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <!-- Muted text = text @ 55% -->
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextColor}" Opacity="0.55" />
  <!-- Divider = text @ 16% -->
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource TextColor}" Opacity="0.16" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="Accent200Brush" Color="{StaticResource Accent200Color}" />
  <SolidColorBrush x:Key="Accent300Brush" Color="{StaticResource Accent300Color}" />
  <SolidColorBrush x:Key="Accent400Brush" Color="{StaticResource Accent400Color}" />
  <SolidColorBrush x:Key="Accent800Brush" Color="{StaticResource Accent800Color}" />
  <SolidColorBrush x:Key="Accent900Brush" Color="{StaticResource Accent900Color}" />
  <!-- Accent tints for hover/pressed/selection on dark -->
  <SolidColorBrush x:Key="AccentTint12Brush" Color="{StaticResource AccentColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="AccentTint16Brush" Color="{StaticResource AccentColor}" Opacity="0.16" />
  <SolidColorBrush x:Key="AccentTint22Brush" Color="{StaticResource AccentColor}" Opacity="0.22" />
  <SolidColorBrush x:Key="AccentBorderSelectedBrush" Color="{StaticResource AccentColor}" Opacity="0.40" />

  <SolidColorBrush x:Key="Neutral400Brush" Color="{StaticResource Neutral400Color}" />
  <SolidColorBrush x:Key="Neutral500Brush" Color="{StaticResource Neutral500Color}" />
  <SolidColorBrush x:Key="Neutral600Brush" Color="{StaticResource Neutral600Color}" />
  <SolidColorBrush x:Key="Neutral800Brush" Color="{StaticResource Neutral800Color}" />
  <SolidColorBrush x:Key="Neutral900Brush" Color="{StaticResource Neutral900Color}" />

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <!-- Semantic tints for pill/badge backgrounds -->
  <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningColor}" Opacity="0.14" />
  <SolidColorBrush x:Key="ErrorTintBrush" Color="{StaticResource ErrorColor}" Opacity="0.12" />

  <!-- Caption bar gradient -->
  <LinearGradientBrush x:Key="CaptionBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="{StaticResource CaptionTopColor}" />
    <GradientStop Offset="1" Color="{StaticResource CaptionBottomColor}" />
  </LinearGradientBrush>

  <!-- ══════════════════════════ TYPE ══════════════════════════ -->
  <!-- Bundle Inter under Assets/Fonts/ and use:
       ms-appx:///Assets/Fonts/Inter.ttf#Inter
       Falls back to Segoe UI Variable if Inter is absent. -->
  <FontFamily x:Key="FontHeading">Inter, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FontBody">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>

  <x:Double x:Key="FontSizeH1">42</x:Double>
  <x:Double x:Key="FontSizeH3">25</x:Double>
  <x:Double x:Key="FontSizeH4">20</x:Double>
  <x:Double x:Key="FontSizeTitle">16</x:Double>
  <x:Double x:Key="FontSizeBody">15</x:Double>
  <x:Double x:Key="FontSizeRow">13</x:Double>
  <x:Double x:Key="FontSizeSmall">12</x:Double>
  <x:Double x:Key="FontSizeMicro">11</x:Double>

  <!-- ══════════════════════════ SHAPE / SPACING ══════════════════════════ -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>
  <Thickness x:Key="HairlineThickness">1</Thickness>
  <!-- Compact density (~0.7x): use these as standard paddings -->
  <Thickness x:Key="PadTight">8,6</Thickness>
  <Thickness x:Key="PadStd">11,8</Thickness>
  <Thickness x:Key="PadLoose">14,11</Thickness>

  <!-- Elevation on dark = hairline edge + soft ambient shadow (attach a
       ThemeShadow in code-behind if desired; keep shadows soft, never stacked). -->

  <!-- ══════════════════════════ TEXT STYLES ══════════════════════════ -->
  <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CharacterSpacing" Value="-15" />
    <Setter Property="LineHeight" Value="28" />
  </Style>

  <Style x:Key="TitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
  </Style>

  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
  </Style>

  <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
  </Style>

  <Style x:Key="KickerTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{StaticResource Neutral500Brush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="CharacterSpacing" Value="90" />
    <!-- Set Text in ALL CAPS at the call site; XAML has no text-transform. -->
  </Style>

  <!-- ══════════════════════════ BUTTONS ══════════════════════════ -->
  <!-- Nocturne law: PRIMARY is an accent OUTLINE on transparent, never a fill. -->
  <Style x:Key="NocturneButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentTint12Brush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentTint22Brush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                     To="0.45" Duration="0" />
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary: accent text + accent border, transparent fill -->
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NocturneButtonBase}">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Secondary: divider border, text foreground -->
  <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NocturneButtonBase}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
  </Style>

  <!-- Ghost: accent text, no border -->
  <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource NocturneButtonBase}">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ══════════════════════════ TEXTBOX (address bar / search) ══════════════════════════ -->
  <Style x:Key="NocturneTextBoxStyle" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="SelectionHighlightColor" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- ══════════════════════════ CARD / SURFACE PANEL ══════════════════════════ -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    <Setter Property="Padding" Value="{StaticResource PadStd}" />
    <Setter Property="BorderBrush" Value="{StaticResource Neutral800Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ══════════════════════════ MACHINE LIST ROW (ListViewItem) ══════════════════════════ -->
  <Style x:Key="MachineListViewItemStyle" TargetType="ListViewItem">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Grid x:Name="Root" Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentTint12Brush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Selected">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentTint16Brush}" />
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentBorderSelectedBrush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOverSelected">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentTint22Brush}" />
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentBorderSelectedBrush}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════ TAG / PILL ══════════════════════════ -->
  <!-- Use a Border with these for "Redirection live" style pills. -->
  <Style x:Key="AccentTagStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Accent800Brush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style x:Key="SuccessPillStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="9,2" />
  </Style>

  <!-- ══════════════════════════ TRANSFER PROGRESS ══════════════════════════ -->
  <!-- Track for the transfer dock ProgressBar. Fill accent = active,
       Success = done, Error = failed (set Foreground in the row's VM/template).
       For the animated diagonal stripe on active items, overlay an ImageBrush
       or a code-behind Composition animation; the flat fill below is the base. -->
  <Style x:Key="TransferProgressBarStyle" TargetType="ProgressBar">
    <Setter Property="Height" Value="5" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource Neutral900Brush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
  </Style>

  <!-- ══════════════════════════ FADING DIVIDER (Nocturne signature) ══════════════════════════ -->
  <!-- A 1px rule that fades to transparent at both ends. Use as a Rectangle fill. -->
  <LinearGradientBrush x:Key="FadingRuleBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0.0"  Color="{StaticResource TextColor}" />
    <GradientStop Offset="0.06" Color="{StaticResource TextColor}" />
    <GradientStop Offset="0.94" Color="{StaticResource TextColor}" />
    <GradientStop Offset="1.0"  Color="{StaticResource TextColor}" />
    <!-- Set the brush Opacity to 0.16 at use; ends fade via a second overlay
         or use a Rectangle with OpacityMask if exact end-fade is required. -->
  </LinearGradientBrush>

</ResourceDictionary>
