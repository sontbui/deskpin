<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RdpManager.Presentation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="14">
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                   Text="Credential backend, display-match confidence, launch pre-flight and theme. (Full UI is a fast-follow.)" />

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" Padding="16" Margin="0,8,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="About" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Opacity="0.8" />
                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="OnCheckUpdates" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
