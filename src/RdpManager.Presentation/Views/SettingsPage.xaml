<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RdpManager.Presentation.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="14">
            <TextBlock Text="Info" FontSize="22" FontWeight="SemiBold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="About" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Opacity="0.8" />

                    <TextBlock x:Name="WhatsNewTitle" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock x:Name="WhatsNewText" Opacity="0.85" TextWrapping="Wrap" LineHeight="22" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="OnCheckUpdates" />
                        <Button Content="Open logs folder" Click="OnOpenLogs" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Seamless connect (no RDP prompt)" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="To connect with no prompt and full redirection, trust the Deskpin publisher on this machine — one-time, needs admin. This writes the Deskpin certificate thumbprint to the trusted .rdp publishers policy." />
                    <TextBlock x:Name="SeamlessStatus" Opacity="0.7" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EnableSeamlessButton" Content="Trust Deskpin (admin)" Click="OnEnableSeamless" />
                        <Button x:Name="DisableSeamlessButton" Content="Undo" Click="OnDisableSeamless" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.55"
                               Text="If your Windows has no Group Policy (Home edition) this still works via the registry. Thumbprint:" />
                    <TextBox x:Name="ThumbprintBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,8,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Report a bug" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                               Text="Something broke? Describe it below — this opens a pre-filled GitHub issue on the Deskpin repository, and you submit it from your own GitHub account. No credentials are stored in the app." />
                    <TextBox x:Name="BugTitleBox" PlaceholderText="Short title — e.g. Transfer stalls at 99% on large ISOs" />
                    <TextBox x:Name="BugDescBox" PlaceholderText="What happened? What did you expect?"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                    <CheckBox x:Name="BugDiagCheck" IsChecked="True"
                              Content="Attach diagnostics (app version, OS, recent error log)" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ReportBugButton" Content="Report on GitHub" Click="OnReportBug" />
                        <TextBlock x:Name="BugStatus" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
