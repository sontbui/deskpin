<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RdpManager.Presentation.Views.DownloadProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Updating Deskpin"
    CloseButtonText="Cancel">
    <StackPanel Spacing="12" Width="360">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Downloading the latest version…" />
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" />
        <TextBlock x:Name="PercentText" Opacity="0.7" FontSize="12" />
    </StackPanel>
</ContentDialog>
