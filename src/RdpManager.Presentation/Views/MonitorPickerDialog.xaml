<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="RdpManager.Presentation.Views.MonitorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RdpManager.Presentation.ViewModels"
    Title="Which screens should this session open on?"
    PrimaryButtonText="Save &amp; remote"
    SecondaryButtonText="Use all"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <StackPanel Spacing="12" Width="560">
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Click the monitors to include. The one with the ★ (star) becomes the remote's primary screen — you don't need to include your own primary monitor." />
        <ItemsControl ItemsSource="{x:Bind Vm.Monitors}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitorTileViewModel">
                    <Grid Width="150" Height="96">
                        <ToggleButton IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind Resolution}" FontSize="11" Opacity="0.7" HorizontalAlignment="Center" />
                                <TextBlock Text="★ PRIMARY" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="Black"
                                           Visibility="{x:Bind IsSessionPrimary, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ToggleButton>
                        <!-- Set-as-primary button, only when the tile is selected -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                                Background="Transparent" BorderThickness="0" Padding="4"
                                Click="OnSetPrimary" ToolTipService.ToolTip="Set as remote primary"
                                Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon Glyph="&#xE734;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ContentDialog>
