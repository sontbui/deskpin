<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RdpManager.Presentation.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RdpManager.Presentation.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="20,16,20,8" Spacing="4">
            <TextBlock Text="Activity" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Recent sessions, pings and automatic layout re-maps." Opacity="0.6" FontSize="12" />
        </StackPanel>

        <ListView Grid.Row="1" Padding="12,0,12,12" ItemsSource="{x:Bind Vm.Items}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityItemViewModel">
                    <Grid Padding="4,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind EventText}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind MachineName}" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Detail}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind When}" Opacity="0.5" FontSize="12"
                                   VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1" Text="No activity yet — remote to a machine and it'll show up here."
                   Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Page>
