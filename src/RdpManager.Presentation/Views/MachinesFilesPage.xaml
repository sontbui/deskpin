<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RdpManager.Presentation.Views.MachinesFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RdpManager.Presentation.ViewModels"
    Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══════════════ MACHINE MASTER (232px) ══════════════ -->
        <Grid Background="{StaticResource PanelBrush}"
              BorderThickness="0,0,1,0" BorderBrush="{StaticResource DividerBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Padding="13,14,13,10" Spacing="9">
                <Grid>
                    <TextBlock Text="Machines" Style="{StaticResource HeadingTextStyle}"
                               FontSize="15" VerticalAlignment="Center" />
                    <Button Content="+ Add" Style="{StaticResource PrimaryButtonStyle}"
                            Padding="9,3" FontSize="12" HorizontalAlignment="Right"
                            Click="OnAddClick" />
                </Grid>
                <TextBox Style="{StaticResource NocturneTextBoxStyle}"
                         MinHeight="32" FontSize="13"
                         PlaceholderText="Search machines…"
                         Text="{x:Bind Vm.Master.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="CONNECTED" Style="{StaticResource KickerTextStyle}" Margin="14,6,14,4" />
                <ListView Grid.Row="1" Padding="8,0,8,10"
                          ItemsSource="{x:Bind Vm.Master.Machines}"
                          SelectedItem="{x:Bind Vm.Master.Selected, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource MachineListViewItemStyle}"
                          DoubleTapped="OnMachineDoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MachineItemViewModel">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Remote" Click="OnRemoteItem" />
                                        <MenuFlyoutItem Text="Configure display…" Click="OnConfigureItem" />
                                        <MenuFlyoutItem Text="Ping" Click="OnPingItem" />
                                        <MenuFlyoutItem Text="Edit" Click="OnEditItem" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete" Click="OnDeleteItem" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid VerticalAlignment="Center" Width="7" Height="7">
                                    <Ellipse Fill="{StaticResource SuccessBrush}"
                                             Visibility="{x:Bind IsUp, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <Ellipse Fill="{StaticResource Neutral600Brush}"
                                             Visibility="{x:Bind IsUp, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource FontSizeRow}"
                                               FontWeight="Medium" Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind HostLine}" FontSize="{StaticResource FontSizeMicro}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind LatencyText, Mode=OneWay}"
                                           FontSize="10" Foreground="{StaticResource Neutral500Brush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- ══════════════ CONSOLE ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="190" />
            </Grid.RowDefinitions>

            <!-- ── Header toolbar ── -->
            <Grid Padding="18,14" ColumnSpacing="8"
                  BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="{x:Bind Vm.Master.Selected.Name, Mode=OneWay, FallbackValue='No machine selected', TargetNullValue='No machine selected'}"
                                   Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource SuccessPillStyle}" VerticalAlignment="Center"
                                Visibility="{x:Bind Vm.Console.IsRedirectionOn, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Redirection live" FontSize="{StaticResource FontSizeMicro}"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Neutral900Brush}" CornerRadius="20" Padding="9,2"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind Vm.Console.IsRedirectionOffForSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Redirection off" FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.Console.ConnectionText, Mode=OneWay}"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" FontSize="12" Padding="10,5"
                        IsEnabled="{x:Bind Vm.HasSelection, Mode=OneWay}" Click="OnPingClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE95E;" FontSize="13" />
                        <TextBlock Text="Ping" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" FontSize="12" Padding="10,5"
                        IsEnabled="{x:Bind Vm.HasSelection, Mode=OneWay}" Click="OnEditClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" FontSize="12" Padding="10,5"
                        IsEnabled="{x:Bind Vm.HasSelection, Mode=OneWay}" Click="OnDisplayClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                        <TextBlock Text="Display" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" FontSize="12" Padding="10,5"
                        IsEnabled="{x:Bind Vm.HasSelection, Mode=OneWay}" Click="OnOpenRedirection">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8AB;" FontSize="13" />
                        <TextBlock Text="Drive redirection" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource PrimaryButtonStyle}" FontSize="13" Padding="13,5"
                        IsEnabled="{x:Bind Vm.HasSelection, Mode=OneWay}" Click="OnRemoteClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                        <TextBlock Text="Remote" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Dual-pane commander ── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LOCAL pane -->
                <Grid Background="{StaticResource PanelAltBrush}"
                      AllowDrop="True" DragOver="OnPaneDragOver" Drop="OnLocalPaneDrop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="13,10" ColumnSpacing="8"
                          BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F8;" FontSize="15" VerticalAlignment="Center"
                                  Foreground="{StaticResource Neutral400Brush}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="THIS PC" Style="{StaticResource KickerTextStyle}" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{x:Bind Vm.Console.LocalPane.IsEditingPath, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                <ItemsControl ItemsSource="{x:Bind Vm.Console.LocalPane.Crumbs}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BreadcrumbItemViewModel">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{x:Bind Label}" Click="OnLocalCrumbClick"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Foreground="{StaticResource TextBrush}"
                                                        Padding="3,1" FontSize="12.5" FontWeight="Normal" />
                                                <TextBlock Text="\" Foreground="{StaticResource Neutral600Brush}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Visibility="{x:Bind ShowSeparator, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource GhostButtonStyle}" Padding="4,1"
                                        Command="{x:Bind Vm.Console.LocalPane.BeginEditPathCommand}"
                                        ToolTipService.ToolTip="Type or paste a directory path">
                                    <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{StaticResource Neutral500Brush}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{x:Bind Vm.Console.LocalPane.IsEditingPath, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Style="{StaticResource NocturneTextBoxStyle}" MinWidth="220" MinHeight="28" FontSize="12"
                                         Text="{x:Bind Vm.Console.LocalPane.PathDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Paste a path — C:\Users\you\Documents"
                                         KeyDown="OnLocalPathKeyDown" />
                                <Button Content="Go" Style="{StaticResource GhostButtonStyle}"
                                        Command="{x:Bind Vm.Console.LocalPane.GoToPathCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource GhostButtonStyle}" Padding="6"
                                    Command="{x:Bind Vm.Console.LocalPane.UpCommand}" ToolTipService.ToolTip="Up one level">
                                <FontIcon Glyph="&#xE74A;" FontSize="13" Foreground="{StaticResource Neutral400Brush}" />
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Padding="6"
                                    Command="{x:Bind Vm.Console.LocalPane.RefreshCommand}" ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{StaticResource Neutral400Brush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Padding="16,4" ColumnSpacing="8"
                          BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NAME" Style="{StaticResource KickerTextStyle}" />
                        <TextBlock Grid.Column="1" Text="SIZE" Style="{StaticResource KickerTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="MODIFIED" Style="{StaticResource KickerTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView x:Name="LocalList" Padding="6,4"
                                  ItemsSource="{x:Bind Vm.Console.LocalPane.Items}"
                                  ItemContainerStyle="{StaticResource MachineListViewItemStyle}"
                                  SelectionMode="Extended"
                                  CanDragItems="True"
                                  DragItemsStarting="OnLocalDragItemsStarting"
                                  SelectionChanged="OnLocalSelectionChanged"
                                  DoubleTapped="OnLocalDoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileEntryViewModel">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Upload" Click="OnLocalUploadItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE898;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Rename" Click="OnLocalRenameItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="New folder" Click="OnLocalNewFolderItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Properties" Click="OnLocalPropertiesItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete" Click="OnLocalDeleteItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid VerticalAlignment="Center" Width="18">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource Accent400Brush}"
                                                      Visibility="{x:Bind IsFolder, Converter={StaticResource BoolToVisibility}}" />
                                            <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{StaticResource Neutral400Brush}"
                                                      Visibility="{x:Bind IsFile, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="{StaticResource FontSizeRow}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="11.5"
                                                   Foreground="{StaticResource Neutral400Brush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" FontSize="11.5"
                                                   Foreground="{StaticResource Neutral500Brush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="24"
                                    Visibility="{x:Bind Vm.Console.LocalPane.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="26" Foreground="{StaticResource Neutral500Brush}" HorizontalAlignment="Center" />
                            <TextBlock Text="This folder is empty" Style="{StaticResource TitleTextStyle}" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.Console.LocalPane.EmptyText}" Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap" MaxWidth="260" TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="24"
                                    Visibility="{x:Bind Vm.Console.LocalPane.IsAccessDenied, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon Glyph="&#xE72E;" FontSize="26" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Access denied" Style="{StaticResource TitleTextStyle}" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.Console.LocalPane.AccessDeniedText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center" />
                            <Button Content="Back" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center"
                                    Command="{x:Bind Vm.Console.LocalPane.BackCommand}" />
                        </StackPanel>

                        <InfoBar IsOpen="{x:Bind Vm.Console.LocalPane.HasError, Mode=OneWay}" Severity="Error"
                                 Message="{x:Bind Vm.Console.LocalPane.ErrorText, Mode=OneWay}"
                                 VerticalAlignment="Bottom" Margin="8" />
                        <ProgressRing IsActive="{x:Bind Vm.Console.LocalPane.IsLoading, Mode=OneWay}" Width="28" Height="28"
                                      Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                </Grid>

                <!-- center transfer controls -->
                <Grid Grid.Column="1" Background="{StaticResource PanelBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <Button Width="40" Height="40" Padding="0" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind Vm.Console.SendCommand}"
                            IsEnabled="{x:Bind Vm.Console.HasLocalSelection, Mode=OneWay}"
                            ToolTipService.ToolTip="Send to remote">
                        <FontIcon Glyph="&#xE72A;" FontSize="15" />
                    </Button>
                    <Button Width="40" Height="40" Padding="0" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind Vm.Console.GetCommand}"
                            IsEnabled="{x:Bind Vm.Console.HasRemoteSelection, Mode=OneWay}"
                            ToolTipService.ToolTip="Get from remote">
                        <FontIcon Glyph="&#xE72B;" FontSize="15" />
                    </Button>
                </StackPanel>
                </Grid>

                <!-- REMOTE pane -->
                <Grid Grid.Column="2" Background="{StaticResource PanelAltBrush}"
                      AllowDrop="True" DragOver="OnPaneDragOver" Drop="OnRemotePaneDrop"
                      BorderThickness="1,0,0,0" BorderBrush="{StaticResource DividerBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="13,10" ColumnSpacing="8"
                          BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" FontSize="15" VerticalAlignment="Center"
                                  Foreground="{StaticResource AccentBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Vm.Console.RemotePane.Title, Mode=OneWay}"
                                       Style="{StaticResource KickerTextStyle}"
                                       Foreground="{StaticResource AccentBrush}" />
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{x:Bind Vm.Console.RemotePane.IsEditingPath, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                                <ItemsControl ItemsSource="{x:Bind Vm.Console.RemotePane.Crumbs}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BreadcrumbItemViewModel">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{x:Bind Label}" Click="OnRemoteCrumbClick"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Foreground="{StaticResource TextBrush}"
                                                        Padding="3,1" FontSize="12.5" FontWeight="Normal" />
                                                <TextBlock Text="\" Foreground="{StaticResource Neutral600Brush}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Visibility="{x:Bind ShowSeparator, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource GhostButtonStyle}" Padding="4,1"
                                        Command="{x:Bind Vm.Console.RemotePane.BeginEditPathCommand}"
                                        ToolTipService.ToolTip="Type or paste a directory path">
                                    <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{StaticResource Neutral500Brush}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{x:Bind Vm.Console.RemotePane.IsEditingPath, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Style="{StaticResource NocturneTextBoxStyle}" MinWidth="220" MinHeight="28" FontSize="12"
                                         Text="{x:Bind Vm.Console.RemotePane.PathDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Paste a path — C:\Users\svc\Downloads"
                                         KeyDown="OnRemotePathKeyDown" />
                                <Button Content="Go" Style="{StaticResource GhostButtonStyle}"
                                        Command="{x:Bind Vm.Console.RemotePane.GoToPathCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource GhostButtonStyle}" Padding="6"
                                    Command="{x:Bind Vm.Console.RemotePane.UpCommand}" ToolTipService.ToolTip="Up one level">
                                <FontIcon Glyph="&#xE74A;" FontSize="13" Foreground="{StaticResource Neutral400Brush}" />
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Padding="6"
                                    Command="{x:Bind Vm.Console.RemotePane.RefreshCommand}" ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{StaticResource Neutral400Brush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Padding="16,4" ColumnSpacing="8"
                          BorderThickness="0,0,0,1" BorderBrush="{StaticResource DividerBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NAME" Style="{StaticResource KickerTextStyle}" />
                        <TextBlock Grid.Column="1" Text="SIZE" Style="{StaticResource KickerTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="MODIFIED" Style="{StaticResource KickerTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView x:Name="RemoteList" Padding="6,4"
                                  ItemsSource="{x:Bind Vm.Console.RemotePane.Items}"
                                  ItemContainerStyle="{StaticResource MachineListViewItemStyle}"
                                  SelectionMode="Extended"
                                  CanDragItems="True"
                                  DragItemsStarting="OnRemoteDragItemsStarting"
                                  SelectionChanged="OnRemoteSelectionChanged"
                                  DoubleTapped="OnRemoteDoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileEntryViewModel">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Download" Click="OnRemoteDownloadItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Rename" Click="OnRemoteRenameItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="New folder" Click="OnRemoteNewFolderItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Properties" Click="OnRemotePropertiesItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete" Click="OnRemoteDeleteItem">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid VerticalAlignment="Center" Width="18">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource Accent400Brush}"
                                                      Visibility="{x:Bind IsFolder, Converter={StaticResource BoolToVisibility}}" />
                                            <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{StaticResource Neutral400Brush}"
                                                      Visibility="{x:Bind IsFile, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="{StaticResource FontSizeRow}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="11.5"
                                                   Foreground="{StaticResource Neutral400Brush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" FontSize="11.5"
                                                   Foreground="{StaticResource Neutral500Brush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="24"
                                    Visibility="{x:Bind Vm.Console.RemotePane.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="26" Foreground="{StaticResource Neutral500Brush}" HorizontalAlignment="Center" />
                            <TextBlock Text="This folder is empty" Style="{StaticResource TitleTextStyle}" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.Console.RemotePane.EmptyText}" Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap" MaxWidth="260" TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Padding="24"
                                    Visibility="{x:Bind Vm.Console.RemotePane.IsAccessDenied, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon Glyph="&#xE72E;" FontSize="26" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Access denied" Style="{StaticResource TitleTextStyle}" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind Vm.Console.RemotePane.AccessDeniedText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center" />
                            <Button Content="Back" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center"
                                    Command="{x:Bind Vm.Console.RemotePane.BackCommand}" />
                        </StackPanel>

                        <InfoBar IsOpen="{x:Bind Vm.Console.RemotePane.HasError, Mode=OneWay}" Severity="Error"
                                 Message="{x:Bind Vm.Console.RemotePane.ErrorText, Mode=OneWay}"
                                 VerticalAlignment="Bottom" Margin="8" />
                        <ProgressRing IsActive="{x:Bind Vm.Console.RemotePane.IsLoading, Mode=OneWay}" Width="28" Height="28"
                                      Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                </Grid>

                <!-- console-disabled overlays -->
                <Grid Grid.ColumnSpan="3" Background="{StaticResource PanelBrush}"
                      Visibility="{x:Bind Vm.Console.IsRedirectionOffForSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="380">
                        <FontIcon Glyph="&#xE8AB;" FontSize="28" Foreground="{StaticResource Neutral500Brush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Drive redirection is off" Style="{StaticResource TitleTextStyle}" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" TextAlignment="Center"
                                   Text="Redirection is what makes transfers possible — the remote session can't see any local drive right now, so the console is disabled for this machine." />
                        <Button Content="Turn on drive redirection…" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center" Click="OnOpenRedirection" />
                    </StackPanel>
                </Grid>

                <Grid Grid.ColumnSpan="3" Background="{StaticResource PanelBrush}"
                      Visibility="{x:Bind Vm.HasMachines, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="380">
                        <FontIcon Glyph="&#xE7F4;" FontSize="28" Foreground="{StaticResource Neutral500Brush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No machines yet" Style="{StaticResource TitleTextStyle}" FontSize="15" HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" TextAlignment="Center"
                                   Text="Add a machine with the + Add button on the left — file transfers ride that machine's RDP drive redirection." />
                        <Button Content="+ Add machine" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center" Click="OnAddClick" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ── Transfer dock (190px) ── -->
            <Grid Grid.Row="2" Background="{StaticResource PanelBrush}"
                  BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="14,8,14,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Button Content="{x:Bind Vm.Console.Dock.QueueTabText, Mode=OneWay}"
                                Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource TextBrush}"
                                FontSize="12.5" Command="{x:Bind Vm.Console.Dock.ShowQueueCommand}" />
                        <Rectangle Height="2" Fill="{StaticResource AccentBrush}" Margin="6,0"
                                   Visibility="{x:Bind Vm.Console.Dock.IsQueueTabSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Button Content="History"
                                Style="{StaticResource GhostButtonStyle}" Foreground="{StaticResource TextBrush}"
                                FontSize="12.5" Command="{x:Bind Vm.Console.Dock.ShowHistoryCommand}" />
                        <Rectangle Height="2" Fill="{StaticResource AccentBrush}" Margin="6,0"
                                   Visibility="{x:Bind Vm.Console.Dock.IsHistoryTabSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{x:Bind Vm.Console.Dock.SummaryText, Mode=OneWay}"
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Content="Clear finished" Style="{StaticResource GhostButtonStyle}"
                            FontSize="11" Command="{x:Bind Vm.Console.Dock.ClearFinishedCommand}" />
                </Grid>

                <!-- Queue tab -->
                <Grid Grid.Row="1"
                      Visibility="{x:Bind Vm.Console.Dock.IsQueueTabSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ListView Padding="8,0,8,8" ItemsSource="{x:Bind Vm.Console.Dock.Jobs}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferJobViewModel">
                                <Grid ColumnSpacing="10" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind DirectionGlyph}" FontSize="13" VerticalAlignment="Center"
                                              Foreground="{x:Bind BarState, Mode=OneWay, Converter={StaticResource TransferStateToBrush}}" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind FileName}" FontSize="12.5" FontWeight="Medium"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind MetaText, Mode=OneWay}" FontSize="{StaticResource FontSizeMicro}"
                                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ProgressBar Style="{StaticResource TransferProgressBarStyle}"
                                                     Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                     Foreground="{x:Bind BarState, Mode=OneWay, Converter={StaticResource TransferStateToBrush}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="{StaticResource FontSizeMicro}"
                                                   Foreground="{x:Bind BarState, Mode=OneWay, Converter={StaticResource TransferStateToBrush}}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Retry" Style="{StaticResource SecondaryButtonStyle}" FontSize="10.5" Padding="8,2"
                                                Command="{x:Bind RetryCommand}"
                                                Visibility="{x:Bind ShowRetry, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource GhostButtonStyle}" Padding="4"
                                                Command="{x:Bind CancelCommand}" ToolTipService.ToolTip="Cancel"
                                                Visibility="{x:Bind ShowCancel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource Neutral500Brush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="Nothing in the queue. Select files and transfer."
                               Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{x:Bind Vm.Console.Dock.IsQueueEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- History tab -->
                <ListView Grid.Row="1" Padding="8,0,8,8" SelectionMode="None"
                          ItemsSource="{x:Bind Vm.Console.Dock.HistoryItems}"
                          Visibility="{x:Bind Vm.Console.Dock.IsHistoryTabSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TransferHistoryItemViewModel">
                            <Grid ColumnSpacing="10" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind DirectionGlyph}" FontSize="12" Foreground="{StaticResource Neutral400Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontSize="12.5"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="11.5" Foreground="{StaticResource Neutral400Brush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind WhenText}" FontSize="11.5" Foreground="{StaticResource Neutral500Brush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ResultText}" FontSize="11.5"
                                           Foreground="{x:Bind ResultState, Converter={StaticResource TransferStateToBrush}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
