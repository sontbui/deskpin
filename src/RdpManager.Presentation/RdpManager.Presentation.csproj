<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RdpManager.Presentation</RootNamespace>
    <AssemblyName>Deskpin</AssemblyName>
    <Product>Deskpin</Product>
    <Company>sontbui</Company>
    <!-- Overridden by CI from the git tag (see .github/workflows/release.yml). -->
    <Version>1.3.0</Version>
    <ApplicationIcon>Assets\deskpin.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- Run unpackaged (plain .exe). This makes the Windows App SDK auto-initialize its
         bootstrapper at startup; without it the XAML Application COM class isn't registered
         and Application.Start throws REGDB_E_CLASSNOTREG. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250310001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RdpManager.Application\RdpManager.Application.csproj" />
    <ProjectReference Include="..\RdpManager.Infrastructure\RdpManager.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the icon next to the exe so the window/taskbar icon can be set at runtime. -->
    <Content Include="Assets\deskpin.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ship the release notes so the About page can show "What's new" offline. -->
    <None Include="..\..\release-notes\*.json" Link="release-notes\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
