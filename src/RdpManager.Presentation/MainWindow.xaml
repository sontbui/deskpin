<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RdpManager.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Windows 11 caption bar with a centered command bar -->
        <Grid x:Name="AppTitleBar" Height="40" Background="{StaticResource CaptionBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
                <!-- Logo mark: Aperture Pin — diamond ring with a center pupil (even-odd fill), 14px accent. -->
                <PathIcon Data="F0 M8 1 L15 8 L8 15 L1 8 Z M8 4 L12 8 L8 12 L4 8 Z M8 6.4 L9.6 8 L8 9.6 L6.4 8 Z"
                          Foreground="{StaticResource AccentBrush}" Width="14" Height="14"
                          />
                <TextBlock Text="RDP Manager" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            </StackPanel>
            <AutoSuggestBox x:Name="Omni" PlaceholderText="Search or run a command  (Ctrl+K)"
                            Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                            QueryIcon="Find" />
        </Grid>

        <NavigationView Grid.Row="1" x:Name="Nav" PaneDisplayMode="LeftCompact"
                        IsSettingsVisible="False" SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Machines &amp; Files" Tag="MachinesFiles" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="Activity">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Info" Tag="Info">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Non-blocking toast, bound to ToastService -->
        <InfoBar x:Name="Toast" Grid.Row="1" IsOpen="False" Severity="Success"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" MaxWidth="380" />
    </Grid>
</Window>
